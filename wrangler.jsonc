{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kai-trad-pwa",
  "main": "./worker-v1112.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "TRADING_STATE", "class_name": "TradingState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TradingState"] }],
  "vars": {
    "TRADING_MODE": "paper",
    "SYMBOL": "BTCUSDT",
    "SCAN_SYMBOLS": "BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT",
    "INTERVAL": "15m",
    "FAST_INTERVAL": "5m",
    "STARTING_BALANCE": "10000",
    "RISK_PER_TRADE": "0.01",
    "MAX_POSITION_PCT": "0.20",
    "MAX_DAILY_LOSS_PCT": "0.03",
    "MIN_SIGNAL_CONFIDENCE": "70",

    // Legacy internal switch retained so the existing PAPER-only liquidity
    // observe path remains active while the larger evidence program runs.
    "PAPER_TRIAL_MODE": "SAMPLE_10",
    "PAPER_TRIAL_MIN_SIGNAL_CONFIDENCE": "60",
    "PAPER_TRIAL_MIN_ACTIVE_RATIO": "0.30",
    "PAPER_TRIAL_AI_VALIDATION": "false",

    "PAPER_EVIDENCE_MIN_CLOSED": "100",
    "PAPER_EVIDENCE_TARGET_CLOSED": "200",
    "PAPER_FEE_RATE": "0.001",
    "PAPER_EVIDENCE_MAX_QUOTE_AGE_MS": "10000",
    "KAI_SANBAN_LIVE_GATE": "LOCKED",

    "PRIMARY_BROKER": "indodax",
    "INDODAX_API_BASE_URL": "https://indodax.com",
    "TOKOCRYPTO_API_BASE_URL": "https://www.tokocrypto.com",
    "TOKOCRYPTO_PUBLIC_BASE_URL": "https://www.tokocrypto.site",
    "BROKER_LIVE_STAGE": "LOCKED",
    "TOKOCRYPTO_LIVE_ACK": "NOT_ACKNOWLEDGED",
    "USD_IDR_RATE": "17850",
    "DAILY_GOAL_MIN_USD": "3",
    "DAILY_GOAL_MAX_USD": "5",
    "PC_FUND_TARGET_IDR": "0",
    "PC_FUND_SAVED_IDR": "0",
    "MAX_CONSECUTIVE_LOSSES": "3",
    "LOSS_STREAK_COOLDOWN_MINUTES": "240",
    "AI_VALIDATION": "true",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "ENGINE_INTERVAL_SECONDS": "60",
    "MARKET_DATA_BASE_URL": "https://indodax.com",
    "TRADE_BASE_URL": "https://api.binance.com",
    "ENABLE_LIVE_EXECUTION": "NO"
  }
}
